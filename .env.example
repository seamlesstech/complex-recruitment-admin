# Same Supabase project as complex-recruitment-website.
#
# This is the ENTIRE runtime environment surface of the admin app (verified by
# grepping src/ for process.env — see src/lib/supabase/{server,client,proxy}.ts).
# Every admin screen and the private document route run under the signed-in
# user's own session (RLS-enforced), so no service-role key is needed or used
# here — do not add SUPABASE_SECRET_KEY to this app's deployment.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
